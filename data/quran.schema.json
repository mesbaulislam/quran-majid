{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["surahs"],
  "properties": {
    "surahs": {
      "type": "array",
      "minItems": 114,
      "maxItems": 114,
      "items": {
        "type": "object",
        "required": ["number", "arabicName", "bengaliName", "englishName", "ayahCount", "ayahs"],
        "properties": {
          "number": { "type": "integer", "minimum": 1, "maximum": 114 },
          "arabicName": { "type": "string", "minLength": 1 },
          "bengaliName": { "type": "string", "minLength": 1 },
          "englishName": { "type": "string", "minLength": 1 },
          "ayahCount": { "type": "integer", "minimum": 1 },
          "ayahs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["number", "arabic", "pronunciation", "translation"],
              "properties": {
                "number": { "type": "integer", "minimum": 1 },
                "arabic": { "type": "string", "minLength": 1 },
                "pronunciation": { "type": "string", "minLength": 0 },
                "translation": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
